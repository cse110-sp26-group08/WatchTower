{
  "name": "watchtower-backend",
  "version": "1.0.0",
  "description": "Express backend for WatchTower frontend serving homepage and static assets.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
