{
  "name": "watchtower-backend",
  "version": "1.0.0",
  "description": "Express backend for WatchTower frontend serving homepage and static assets.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "drizzle-kit migrate && node app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.0",
    "express": "^4.18.4",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "node-cron": "^4.2.1",
    "@sendgrid/mail": "^8.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
