{
  "name": "watchtower-backend",
  "version": "1.0.0",
  "description": "Hono backend for WatchTower, deployable on Cloudflare Workers.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "drizzle-kit migrate && node dev.js",
    "migrate": "drizzle-kit migrate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "deploy": "wrangler deploy"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@neondatabase/serverless": "^0.10.4",
    "@sendgrid/mail": "^8.1.3",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
